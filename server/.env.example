# App
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/prospectmind

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_REFRESH_SECRET=your_refresh_secret_change_this
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Groq API
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b,qwen/qwen3-32b,openai/gpt-oss-20b,llama-3.1-8b-instant

# Gemini API — primary provider (Groq currently on hold, see claudeClient.js GROQ_ENABLED)
# Preferred: Vertex AI, billed against a GCP project's billing account.
#   Requires `gcloud auth application-default login` (or a service account) with the
#   Vertex AI User role on the project, and the Vertex AI API enabled.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Fallback: AI Studio API key, used only if GOOGLE_CLOUD_PROJECT is unset. Separate prepay
# billing pool from Vertex AI — get a key at: https://aistudio.google.com/app/apikey
#
# The free tier caps requests PER DAY, PER MODEL, PER PROJECT — a key belongs
# to one project, so multiple keys from separate projects each get their own
# allowance. GEMINI_API_KEYS (comma-separated) lists as many as you have;
# askGemini rotates across them, skipping a key immediately once its quota is
# exhausted rather than retrying it. GEMINI_API_KEY (singular) still works as
# a one-key list.
GEMINI_API_KEY=
GEMINI_API_KEYS=
# Alias names, not pinned versions — Google resolves an alias server-side to
# whatever's current for that key's PROJECT, which matters because different
# keys/projects can be on different model generations (an older project may
# still see 2.5-class models; a newer one may only have 3.x, with a 2.5 model
# name returning 404 "no longer available to new users"). A pinned version
# number is a ticking deprecation.
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODELS=gemini-flash-latest

# Local AI — self-hosted groq-ai-api backend (fans out across 6 Groq-hosted
# models behind one endpoint). Last-resort fallback, only reached after
# Gemini's whole model+key chain fails. Leave unset to skip it entirely.
LOCAL_AI_BASE_URL=http://localhost:4000

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# Resend (Email)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@prospectmind.ai

# Newsletters
# Public origin of THIS server. CLIENT_URL points at the SPA and is the wrong
# host for the unsubscribe route, which is an API endpoint recipients open directly.
PUBLIC_API_URL=http://localhost:5001
# Signs unsubscribe links. Set this once and NEVER rotate it: changing it
# invalidates the unsubscribe link in every email already sitting in a recipient's
# inbox, which is a compliance incident. Falls back to JWT_SECRET in dev.
NEWSLETTER_UNSUBSCRIBE_SECRET=
# Sends newsletters from a separate verified subdomain so that spam complaints
# can't damage the reputation of the domain delivering password resets.
RESEND_NEWSLETTER_FROM_EMAIL=
# Emails per second. Below Resend's ~2/s account cap on purpose — the cap is
# shared with transactional mail, which must not queue behind a 40-minute blast.
NEWSLETTER_SEND_RATE=1.5
# true = log instead of send. Lets a full blast be exercised end to end without
# spending quota or risking a real send.
NEWSLETTER_DRY_RUN=false

# Redis (for job queue)
REDIS_URL=redis://localhost:6379

# External APIs (optional enrichment sources)
SERPER_API_KEY=
HUNTER_API_KEY=
GITHUB_TOKEN=
